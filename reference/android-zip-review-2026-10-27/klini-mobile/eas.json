{
  "cli": {
    "version": ">=16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "payments-test": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_NO_DOTENV": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "ios": {
        "simulator": false
      }
    },
    "standalone": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_CLIENT_ENV_VARS": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "testflight": {}
  }
}
