{
  "name": "klini-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android --go",
    "web": "expo start --web",
    "ai:server": "node --env-file-if-exists=.env.ai.local --import tsx scripts/ai-server.ts",
    "payments:setup": "node --import tsx scripts/setup-payments-test.ts",
    "payments:server": "node --env-file-if-exists=.env.payments.local --import tsx scripts/payments-server.ts",
    "android:native": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:e2e": "node --import tsx scripts/verify-ui.ts",
    "export:android": "expo export --platform android --output-dir dist-android",
    "lint": "expo lint --no-cache",
    "test:navigation": "node --import tsx scripts/verify-navigation.ts",
    "start:dev": "expo start --dev-client",
    "build:ios:test": "node ./scripts/eas-build-ios-test.cjs",
    "build:ios:payments-test": "node ./scripts/eas-build-ios-test.cjs payments-test",
    "start:tunnel": "node ./scripts/start-dev-tunnel.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.81.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
