# PUBLIC build configuration for the authenticated account wallet.
# Candidate production API on the domain selected by the user.
# Do not enable until the backend, redemption flow and webhook are deployed and verified.
EXPO_PUBLIC_PAYMENTS_API_URL=https://klini.us/api/mobile/v1
EXPO_PUBLIC_PAYMENTS_MODE=live
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.mx.klini.review
# The publishable key comes from the authenticated API. No embedded key is needed.
# NEVER place Stripe secret keys, webhook secrets or bearer tokens in EXPO_PUBLIC_ variables.
