# Copia estos campos PÚBLICOS a .env.development.local sin borrar su configuración actual.
# Nunca añadas aquí STRIPE_SECRET_KEY ni KLINI_PAYMENTS_DEV_TOKEN.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APPLE_MERCHANT_ID=
# Dirección HTTPS o IP privada del servidor local; en iPhone 127.0.0.1 es el propio iPhone.
EXPO_PUBLIC_PAYMENTS_TEST_API_URL=
